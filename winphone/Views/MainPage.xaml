<Page
    x:Class="WifiAnalyzer.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title on the left, the band switch on the right. The two bands
             are separate graphs rather than one axis, because 2.4 and 5 GHz are
             600 MHz apart and would leave most of a shared axis empty. -->
        <Grid Grid.Row="0" Margin="12,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="R WiFi Analyzer"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource SubtitleTextBlockStyle}"/>

            <Button x:Name="Band24Button"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,2"
                    Click="OnBand24Click">
                <TextBlock>
                    <Run Text="2.4" FontSize="20"/><Run Text=" Ghz" FontSize="11"/>
                </TextBlock>
            </Button>

            <Button x:Name="Band5Button"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,2"
                    Click="OnBand5Click">
                <TextBlock>
                    <Run Text="5" FontSize="20"/><Run Text=" Ghz" FontSize="11"/>
                </TextBlock>
            </Button>

            <Button x:Name="RefreshButton"
                    Grid.Column="3"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,2"
                    Content="&#x21BB;"
                    FontSize="20"
                    Click="OnRefreshClick"/>
        </Grid>

        <!-- The graph is drawn into this Canvas from code; see SignalGraph.cs. -->
        <Canvas x:Name="GraphCanvas"
                Grid.Row="1"
                Margin="6,4,6,4"
                Background="#FF0A0A0A"
                SizeChanged="OnGraphSizeChanged"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="12,4,12,8"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Style="{ThemeResource CaptionTextBlockStyle}"/>
    </Grid>
</Page>
