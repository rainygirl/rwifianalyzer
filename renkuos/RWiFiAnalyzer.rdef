resource app_signature "application/x-vnd.RWiFiAnalyzer";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "R WiFi Analyzer",
	long_info = "R WiFi Analyzer - Wi-Fi channel and signal strength graph"
};

/* Bitmap icons rather than the usual HVIF vector icon: HVIF comes out of
   Icon-O-Matic, and these are generated by tools/make-icons.py from the same
   glyph the other two ports use. B_CMAP8 data, index 255 transparent; RenkuOS falls
   back to these when a file has no BEOS:ICON attribute. See AGENTS.md. */
resource(101, "BEOS:L:STD_ICON") #'ICON' array import "icons/icon-large.raw";
resource(101, "BEOS:M:STD_ICON") #'MICN' array import "icons/icon-mini.raw";
